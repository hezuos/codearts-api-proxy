# CodeArts Agent Proxy 环境变量示例
# 使用前请复制为 .env，并替换所有敏感占位值。
# 生产环境必须设置真实的 ENCRYPTION_KEY，不能使用下面的开发默认值。

# ==================== 服务基础配置 ====================
PORT=1455
CALLBACK_PORT=1455
NODE_ENV=production
REQUEST_BODY_LIMIT=10mb
DATA_DIR=data

# 客户端访问代理时使用的 Bearer Token
#DEFAULT_API_KEY=请替换为客户端访问密钥

# 用于加密 data/ 中 AK/SK 和会话信息的密钥
# 推荐使用 32 字节随机值的 Base64 字符串。
#ENCRYPTION_KEY=请替换为32字节随机加密密钥

# ==================== 华为云服务配置 ====================
IDE_VERSION=26.3.11
PLUGIN_VERSION=26.3.5

HUAWEI_REDIRECT_HOST=https://devcloud.cn-north-4.huaweicloud.com/codeartside
HUAWEI_API_HOST=https://ide.cn-north-4.myhuaweicloud.com
HUAWEI_CHAT_HOST=https://snap-access.cn-north-4.myhuaweicloud.com
HUAWEI_IAM_HOST=https://iam.cn-north-4.myhuaweicloud.com

# 留空时根据 HUAWEI_CHAT_HOST 和 HUAWEI_IS_INNER_VERSION 自动派生
HUAWEI_GPTS_URL=
HUAWEI_AGENT_ID=
HUAWEI_IS_INNER_VERSION=false

# 是否启用后台会话刷新任务
ENABLE_REFRESH_TASK=true

# 多实例部署时只让主节点执行刷新任务
IS_MASTER_NODE=true

# ==================== 模型和请求配置 ====================
# 模型列表文件缓存时间，单位：秒
MODEL_CACHE_TTL=300

# 上游 HTTPS 请求超时时间，单位：毫秒
UPSTREAM_TIMEOUT_MS=120000

# ==================== 限流配置 ====================
# 每个 API Key 在限流窗口内允许的聊天请求数
RATE_LIMIT_CHAT_MAX=60

# 每个 API Key 在限流窗口内允许的模型列表请求数
RATE_LIMIT_MODELS_MAX=120

# ==================== 上游并发控制 ====================

# 上游单账号并发会话上限为 3，代理侧按账号 FIFO 排队。
# 该上限是账号级共享的（官方 IDE、其他客户端也会占用），因此撞限后
# 有效上限会自动下调，最低到 UPSTREAM_MIN_CONCURRENCY。
# 0 表示不限制（不建议）。
UPSTREAM_MAX_CONCURRENCY=3
# 自适应降级的下限。
UPSTREAM_MIN_CONCURRENCY=1
# 连续无撞限多久后逐级恢复（毫秒）。
UPSTREAM_CONCURRENCY_RECOVER_MS=60000

# 回调 redirect 白名单主机（远稚分隔），用于开放重定向防护；
# 默认已含华为云重定向主机与 127.0.0.1/localhost。
# REDIRECT_ALLOWED_HOSTS=

# 全局 IP 限流（覆盖无专用限流器的路由，如 OAuth 回调 / Web UI / Admin）。
RATE_LIMIT_GLOBAL_MAX=300
# 排队等待槽位超时（毫秒），0 表示无限等待。
UPSTREAM_QUEUE_WAIT_TIMEOUT_MS=120000
# 上游返回 TM.00001041 时的重试次数与基础退避（毫秒）。
UPSTREAM_CONCURRENCY_RETRY_MAX=2
UPSTREAM_CONCURRENCY_RETRY_DELAY_MS=1500

# 上游 CodeArts 累积 prompt 长度硬限制（token 数）。
# 超过此值上游会返回 ChatAgent.00001216 错误。
UPSTREAM_PROMPT_TOKEN_LIMIT=196608

# ==================== 日志和管理配置 ====================
# 可选：debug、info、warn、error
LOG_LEVEL=debug

# Admin 面板密码。首次配置时使用，建议设置至少 8 个字符。
ADMIN_PASSWORD=123qwe!@#QWE